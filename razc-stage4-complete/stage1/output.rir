function tokenValue(i64 kind, string text, i64 pos) -> Token
entry:
    %t0 = new Token
    local Token t
    store t, %t0
    %t1 = load kind
    field_set t.kind = %t1
    %t2 = load text
    field_set t.text = %t2
    %t3 = load pos
    field_set t.pos = %t3
    %t4 = load t
    return %t4
endfunction
